# OpenRouter credentials
OPENROUTER_API_KEY=replace-with-your-key

# Choose any OpenRouter model that supports tool/function calling.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=https://github.com/your-user/your-repo
OPENROUTER_APP_TITLE=OpenRouter Coding Harness

# Harness limits
HARNESS_MAX_STEPS=12
HARNESS_REQUEST_TIMEOUT=120
HARNESS_MAX_FILE_BYTES=200000
HARNESS_MAX_COMMAND_SECONDS=30
